# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx,xlsx,pptx,gif,bmp,tiff,webp
UPLOAD_CHUNK_SIZE_MB=5

# Database Configuration
DATABASE_URL=sqlite:///docpro_database.db
HISTORY_DATABASE_URL=sqlite:///conversion_history.db
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# Performance Configuration
CONVERSION_TIMEOUT_SECONDS=300
TEMP_FILES_CLEANUP_INTERVAL_HOURS=1
TEMP_FILES_MAX_AGE_HOURS=24

# Security Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=3600
CORS_ENABLED=true
ALLOWED_ORIGINS=*
SECURE_HEADERS_ENABLED=true

# API Configuration
API_VERSION=v1
API_DOCUMENTATION_ENABLED=true
REQUEST_TIMEOUT_SECONDS=300

# OCR Configuration
OCR_ENABLED=true
OCR_GPU_ENABLED=false
OCR_LANGUAGES=en

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=60
METRICS_ENABLED=true
METRICS_PORT=8000

# Email Configuration (for notifications)
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@docpro.local

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_LOCATION=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Feature Flags
FEATURE_WATERMARKING=true
FEATURE_OCR=true
FEATURE_BATCH_PROCESSING=true
FEATURE_WEBHOOK_CALLBACKS=false
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_AUDIT_LOG=true
