# Flask Configuration
FLASK_ENV=development
FLASK_APP=app
DEBUG=False

# Database
DATABASE_URL=sqlite:///docpro_database.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Security & Secrets
SECRET_KEY=change-me-in-production-use-strong-random-string
JWT_SECRET_KEY=change-me-in-production-use-strong-random-string
BILLING_PROVIDER_WEBHOOK_SECRET=change-me-in-production-billing-webhook-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=3600

# Celery & Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIMEOUT=1800
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# File Upload & Storage
MAX_UPLOAD_SIZE_MB=500
UPLOAD_FOLDER=./uploads
UPLOAD_CHUNKS_DIR=./chunks

# API Configuration
API_KEY_LENGTH=32
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=3600

# CORS Configuration
CORS_ALLOW_ORIGIN=*
ALLOWED_HOSTS=localhost:3000,localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FORMAT=standard

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=DocPro

# Payment Configuration (Stripe - Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cloud Storage (AWS S3 - Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1

# Error Tracking (Sentry - Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Performance Monitoring (DataDog - Optional)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ORM & Database
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_POOL_RECYCLE=3600

# OCR Configuration (EasyOCR)
OCR_ENABLED=True
OCR_LANGUAGES=en

# LibreOffice Configuration
LIBREOFFICE_ENABLED=True
SOFFICE_PATH=/usr/bin/soffice

# Worker Configuration
WORKER_THREADS=4
WORKER_TIMEOUT=300

# Pagination
ITEMS_PER_PAGE=20

# Cache Configuration
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/2
CACHE_DEFAULT_TIMEOUT=300

# Feature Flags
FEATURE_BATCH_CONVERSION=True
FEATURE_API_KEYS=True
FEATURE_WEBHOOKS=True
FEATURE_ADVANCED_OCR=True

# WhatsApp Bot (Optional)
WHATSAPP_BOT_ENABLED=False
WHATSAPP_API_KEY=your-whatsapp-api-key

# Twilio (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Environment-specific Settings
ENVIRONMENT=development
DEPLOYMENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/3
RATELIMIT_STRATEGY=moving-window
RATELIMIT_DEFAULT=100/hour

# Timezone
TIMEZONE=UTC

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Security Headers
ENABLE_SECURITY_HEADERS=True
ENABLE_CORS=True

# Database Backup
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Feature: Convert to PDF
CONVERT_TO_PDF_ENABLED=True
CONVERT_TO_PDF_QUALITY=high

# Feature: Image Processing
IMAGE_MAX_DIMENSION=4000
IMAGE_COMPRESSION_QUALITY=90

# Feature: PDF Processing
PDF_MAX_PAGES=1000
PDF_OCR_ENABLED=True
