# Production Configuration Template
# Copy to .env and update with your values

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-very-secure-secret-key-change-this-in-production

# Server
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
WORKERS=4

# Security
MAX_FILE_SIZE_MB=100
UPLOAD_API_KEY=your-upload-api-key
BILLING_PROVIDER_WEBHOOK_SECRET=replace-with-a-random-shared-billing-webhook-secret
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
SESSION_TIMEOUT_MINUTES=60
CORS_ORIGINS=http://localhost:3000,https://yourapp.com

# Database
DATABASE_PATH=/var/lib/docpro/database.db
DATABASE_BACKUP_PATH=/var/backups/docpro
DATABASE_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Logging
LOG_LEVEL=INFO
LOG_DIR=/var/log/docpro
LOG_FILE_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=10

# Email (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_FROM_ADDR=noreply@docpro.com

# Webhooks
WEBHOOK_ENABLED=true
WEBHOOK_URL=https://yourapp.com/webhook
WEBHOOK_SECRET=your-webhook-secret

# S3 Storage (optional)
USE_S3=false
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=docpro-files
AWS_REGION=us-east-1

# Redis Caching (optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HOURS=24

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=/var/lib/docpro/analytics.db

# Performance
ENABLE_REQUEST_LOGGING=true
SLOW_QUERY_THRESHOLD_MS=1000
SLOW_REQUEST_THRESHOLD_MS=5000

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=The app is under maintenance

# API Keys
THIRD_PARTY_API_KEYS={"provider1": "key1", "provider2": "key2"}
